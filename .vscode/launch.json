{
    "configurations": [
    {
        "name": "Debug (Normal) Linux64",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/output/Debug/motion",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/output/Debug",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "Debug (No Keyboard) Linux64",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/output/Debug/motion",
        "args": ["+set", "forceEnterSerialMonitor", "1"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/output/Debug",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }

    ]
}